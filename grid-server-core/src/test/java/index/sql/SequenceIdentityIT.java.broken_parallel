package index.sql;

import org.genfork.grid.catalog.TableCatalog;
import org.genfork.grid.sql.SqlEngine;
import org.genfork.grid.sql.SqlResult;
import org.genfork.grid.sql.SqlSession;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;

import java.nio.file.Files;
import java.util.ArrayList;
import java.util.HashSet;
import java.util.List;
import java.util.Set;
import java.util.concurrent.CountDownLatch;
import java.util.concurrent.ExecutorService;
import java.util.concurrent.Executors;
import java.util.concurrent.Future;
import java.util.concurrent.TimeUnit;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertThrows;
import static org.junit.jupiter.api.Assertions.assertTrue;

/**
 * P2.3 SEQUENCE / IDENTITY: concurrent allocate, nextval/currval, INSERT without PK.
 *
 * @author: GenCloud
 * @date: 2026/09
 */
class SequenceIdentityIT {
	private SqlEngine engine;

	@BeforeEach
	void setUp() throws Exception {
		engine = new SqlEngine(new TableCatalog(Files.createTempDirectory("seq-id")), null, 4);
	}

	@Test
	void createSequenceNextvalCurrval() {
		engine.execute("CREATE SEQUENCE s START WITH 10 INCREMENT BY 2");
		final SqlResult n1 = engine.execute("SELECT nextval('s')");
		assertEquals(10L, ((Number) n1.rows().getFirst()[0]).longValue());
		final SqlResult c = engine.execute("SELECT currval('s')");
		assertEquals(10L, ((Number) c.rows().getFirst()[0]).longValue());
		final SqlResult n2 = engine.execute("SELECT nextval('s')");
		assertEquals(12L, ((Number) n2.rows().getFirst()[0]).longValue());
	}

	@Test
	void serialInsertOmitsPk() {
		engine.execute("CREATE TABLE t (id SERIAL PRIMARY KEY, name VARCHAR)");
		engine.execute("INSERT INTO t (name) VALUES ('a')");
		engine.execute("INSERT INTO t (name) VALUES ('b')");
		final SqlResult r = engine.execute("SELECT id, name FROM t WHERE id = 1");
		assertEquals(1, r.rows().size());
		assertEquals(1, ((Number) r.rows().getFirst()[0]).intValue());
		assertEquals("a", r.rows().getFirst()[1]);
		final SqlResult idCol = engine.execute(
				"SELECT is_identity FROM information_schema.columns WHERE table_name = 't' AND column_name = 'id'");
		assertEquals("YES", String.valueOf(idCol.rows().getFirst()[0]));
	}

	@Test
	void generatedByDefaultAsIdentity() {
		engine.execute("CREATE TABLE t (id INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, v INT)");
		engine.execute("INSERT INTO t (v) VALUES (7)");
		engine.execute("INSERT INTO t (id, v) VALUES (99, 8)");
		final SqlResult r = engine.execute("SELECT id FROM t WHERE v = 7");
		assertEquals(1, ((Number) r.rows().getFirst()[0]).intValue());
		final SqlResult r2 = engine.execute("SELECT id FROM t WHERE v = 8");
		assertEquals(99, ((Number) r2.rows().getFirst()[0]).intValue());
	}

	@Test
	void concurrentAllocateUnique() throws Exception {
		engine.execute("CREATE SEQUENCE conc START WITH 1 INCREMENT BY 1");
		final int threads = 8;
		final int perThread = 50;
		final ExecutorService pool = Executors.newFixedThreadPool(threads);
		final CountDownLatch start = new CountDownLatch(1);
		final List<Future<List<Long>>> futures = new ArrayList<>();
		for (int t = 0; t < threads; t++) {
			futures.add(pool.submit(() -> {
				final SqlSession session = engine.newSession();
				start.await();
				final List<Long> got = new ArrayList<>(perThread);
				for (int i = 0; i < perThread; i++) {
					final SqlResult r = engine.execute(session, "SELECT nextval('conc')");
					got.add(Long.valueOf(((Number) r.rows().getFirst()[0]).longValue()));
				}
				return got;
			}));
		}
		start.countDown();
		final Set<Long> all = new HashSet<>();
		for (Future<List<Long>> f : futures) {
			all.addAll(f.get(30, TimeUnit.SECONDS));
		}
		pool.shutdown();
		assertTrue(pool.awaitTermination(5, TimeUnit.SECONDS));
		assertEquals(threads * perThread, all.size());
	}

	@Test
	void currvalWithoutNextvalFails() {
		engine.execute("CREATE SEQUENCE s2");
		assertThrows(IllegalStateException.class, () -> engine.execute("SELECT currval('s2')"));
	}
}
