<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Grid SQL Load Suites">
      <stringProp name="TestPlan.comments">Three suites (enable one at a time; serialize=true): (1) Capacity max — ON by default, KEY_SPACE=1M striping, Error%=0 gate. (2) Chaos — OFF, KEY_SPACE=10k shared PK collisions / lock-wait. (3) Stress — OFF, 128t soak overload. Product grid:// only. Calm host.</stringProp>
      <boolProp name="TestPlan.serialize_threadgroups">true</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments">
          <elementProp name="GRID_URL" elementType="Argument">
            <stringProp name="Argument.name">GRID_URL</stringProp>
            <stringProp name="Argument.value">${__P(GRID_URL,grid://grid:grid@127.0.0.1:15432/public)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="USER" elementType="Argument">
            <stringProp name="Argument.name">USER</stringProp>
            <stringProp name="Argument.value">${__P(USER,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PASSWORD" elementType="Argument">
            <stringProp name="Argument.name">PASSWORD</stringProp>
            <stringProp name="Argument.value">${__P(PASSWORD,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="CONNECT_TIMEOUT_MS" elementType="Argument">
            <stringProp name="Argument.name">CONNECT_TIMEOUT_MS</stringProp>
            <stringProp name="Argument.value">${__P(CONNECT_TIMEOUT_MS,5000)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="OP_TIMEOUT_MS" elementType="Argument">
            <stringProp name="Argument.name">OP_TIMEOUT_MS</stringProp>
            <stringProp name="Argument.value">${__P(OP_TIMEOUT_MS,10000)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="WRITE_BATCH_SIZE" elementType="Argument">
            <stringProp name="Argument.name">WRITE_BATCH_SIZE</stringProp>
            <stringProp name="Argument.value">${__P(WRITE_BATCH_SIZE,1)}</stringProp>
            <stringProp name="Argument.desc">WRITE_ONLY: upserts per TX unit (amortize OpLog/orchid force)</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="TABLE_A" elementType="Argument">
            <stringProp name="Argument.name">TABLE_A</stringProp>
            <stringProp name="Argument.value">${__P(TABLE_A,)}</stringProp>
            <stringProp name="Argument.desc">Override load table A (empty = load_slo_a)</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="TABLE_B" elementType="Argument">
            <stringProp name="Argument.name">TABLE_B</stringProp>
            <stringProp name="Argument.value">${__P(TABLE_B,)}</stringProp>
            <stringProp name="Argument.desc">Override load table B (empty = load_slo_b)</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="SQL_EQ_LIMIT" elementType="Argument">
            <stringProp name="Argument.name">SQL_EQ_LIMIT</stringProp>
            <stringProp name="Argument.value">${__P(SQL_EQ_LIMIT,)}</stringProp>
            <stringProp name="Argument.desc">Template with ${tableA}/${id}; empty = living default</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="SQL_UPSERT" elementType="Argument">
            <stringProp name="Argument.name">SQL_UPSERT</stringProp>
            <stringProp name="Argument.value">${__P(SQL_UPSERT,)}</stringProp>
            <stringProp name="Argument.desc">Template with ${tableA}/${id}/${val}; empty = living default</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="SQL_SHORT_TX_SELECT" elementType="Argument">
            <stringProp name="Argument.name">SQL_SHORT_TX_SELECT</stringProp>
            <stringProp name="Argument.value">${__P(SQL_SHORT_TX_SELECT,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="SQL_SHORT_TX_UPDATE" elementType="Argument">
            <stringProp name="Argument.name">SQL_SHORT_TX_UPDATE</stringProp>
            <stringProp name="Argument.value">${__P(SQL_SHORT_TX_UPDATE,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="SQL_COUNT_JOIN" elementType="Argument">
            <stringProp name="Argument.name">SQL_COUNT_JOIN</stringProp>
            <stringProp name="Argument.value">${__P(SQL_COUNT_JOIN,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="SEED_ROWS" elementType="Argument">
            <stringProp name="Argument.name">SEED_ROWS</stringProp>
            <stringProp name="Argument.value">${__P(SEED_ROWS,1000)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="CAPACITY_KEY_SPACE" elementType="Argument">
            <stringProp name="Argument.name">CAPACITY_KEY_SPACE</stringProp>
            <stringProp name="Argument.value">${__P(CAPACITY_KEY_SPACE,1000000)}</stringProp>
            <stringProp name="Argument.desc">Max-capacity suite: low PK collision + striping</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="CHAOS_KEY_SPACE" elementType="Argument">
            <stringProp name="Argument.name">CHAOS_KEY_SPACE</stringProp>
            <stringProp name="Argument.value">${__P(CHAOS_KEY_SPACE,10000)}</stringProp>
            <stringProp name="Argument.desc">Chaos suite: shared random keys → lock collisions</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="STRESS_KEY_SPACE" elementType="Argument">
            <stringProp name="Argument.name">STRESS_KEY_SPACE</stringProp>
            <stringProp name="Argument.value">${__P(STRESS_KEY_SPACE,1000000)}</stringProp>
            <stringProp name="Argument.desc">Stress suite: large space under high concurrency soak</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="REPORT_DIR" elementType="Argument">
            <stringProp name="Argument.name">REPORT_DIR</stringProp>
            <stringProp name="Argument.value">${__P(REPORT_DIR,D:/workspace/jamoa-grid-cache/grid-sql-jmeter/reports)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
    </TestPlan>
