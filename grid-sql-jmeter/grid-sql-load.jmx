                  <stringProp name="Argument.name">KEY_SPACE</stringProp>
                  <stringProp name="Argument.value">${STRESS_KEY_SPACE}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
                <elementProp name="SEED_ROWS" elementType="Argument">
                  <stringProp name="Argument.name">SEED_ROWS</stringProp>
                  <stringProp name="Argument.value">${SEED_ROWS}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
                <elementProp name="MIX_PROFILE" elementType="Argument">
                  <stringProp name="Argument.name">MIX_PROFILE</stringProp>
                  <stringProp name="Argument.value">STRESS</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
                <elementProp name="STRIPE_THREADS" elementType="Argument">
                  <stringProp name="Argument.name">STRIPE_THREADS</stringProp>
                  <stringProp name="Argument.value">${__P(stressThreads,128)}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
                <elementProp name="MODE" elementType="Argument">
                  <stringProp name="Argument.name">MODE</stringProp>
                  <stringProp name="Argument.value">OPEN</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
            <stringProp name="classname">org.genfork.grid.sql.jmeter.GridSqlOpenSampler</stringProp>
